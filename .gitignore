# Build trees
**/build/
**/build*/
**/build_recomp/
**/build_release/
**/out/
**/CMakeFiles/
**/CMakeCache.txt
**/*.dir/
**/*.obj
**/*.lib
**/*.exe
**/*.dll
**/*.pdb
**/*.dmp
**/*.ilk
**/*.exp
**/*.idb
**/*.tlog
**/*.lastbuildstate
**/*.recipe
**/x64/
**/Debug/
**/Release/
**/RelWithDebInfo/
**/MinSizeRel/
**/.vs/
**/*.sln.docstates
**/*.vcxproj.user

# ROMs and runtime saves (copyrighted / local)
**/*.nes
**/*.fds
**/*.sav
**/*.srm

# Logs and archives
**/*.log
**/*.zip
**/*.7z
**/*.rar

# Bank / CHR extracts (regenerate from ROM)
**/banks/*.bin
**/prg8k_*.bin
**/*.chr.bin

# Linked deps from setup scripts (use sibling nesrecomp-master)
**/nesrecomp
**/nestopia-core

# Tile override runtime dumps
**/tiles/
**/chr_dump/

# Ghidra project DB (large / machine-specific)
**/ghidra/*.rep/
**/ghidra/*.gpr
**/ghidra/*.lock
**/ghidra/*.lock~
**/ghidra/*.gar

# Recompiler audit dumps
**/*_finder_audit.csv
**/*_auto_entries.csv

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
.mcp.json

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/

# Node (if tests present)
**/node_modules/
.pnpm-store/

# Ephemeral playtest / smoke captures (local)
**/playtest*.txt
**/play_rev*.txt
**/smoke*.txt
**/crash_smoke.txt
**/wait_*.txt

# --- Portfolio repository safety defaults ---
# IDE and OS
.vs/
.idea/
.vscode/*.user
*.user
*.suo
.DS_Store
Thumbs.db

# Build outputs
bin/
obj/
build/
build-*/
dist/
out/
target/
Debug/
Release/
.next/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example
secrets.json
credentials.json
config.local.*
*.private.*
*.key
*.pem
!*.example.pem

# Logs, caches, archives and generated executables
*.log
*.tmp
*.cache
*.dmp
*.pdb
*.exe
*.dll
*.zip
*.7z
*.rar

# Proprietary game dumps and extracted runtime data
*.iso
*.cue
*.chd
*.rom
*.nes
*.sfc
*.smc
*.gba
*.gb
*.xex
*.pak
*.wad
*_Data/

# Large media should be replaced by legal samples or tracked with Git LFS
*.mkv
*.mp4
*.wav
*.ogg
*.flac

# Local application state
saves/
local-data/

# --- Portfolio large-artifact exclusions ---
# Generated packages, disk images and ML checkpoints
*.apk
*.apk.gz
*.aab
*.tar
*.tar.gz
*.keras
*.h5
*.onnx
*.pt
*.pth
*.ckpt
*.npz
*.pac

# Generated or locally extracted workspaces
artifacts/
output/
outputs/
game_content/
BombRushCyberfunk/
EvolutionX/

# Temporary Office files
~$*
